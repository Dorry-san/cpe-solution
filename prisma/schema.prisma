generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYER
}

enum ApplicationStatus {
  SCREENING
  SCREENING_FAILED
  MAIN_TEST
  RESULTS_READY
  REJECTED
  HIRED
}

enum TestType {
  SCREENING
  MAIN
}

enum TestStatus {
  GENERATED
  COMPLETED
  EVALUATED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  role         UserRole
  createdAt    DateTime @default(now())

  company Company?
}

model Company {
  id      String  @id @default(cuid())
  name    String
  ownerId String  @unique
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  offers  Offer[]
}

model Offer {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  body           String
  specificNeeds  String
  criticalSkills String?
  domain         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  applications Application[]

  @@index([companyId])
  @@index([isActive, createdAt])
}

model Application {
  id              String            @id @default(cuid())
  offerId         String
  offer           Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String
  phone           String?
  cvPath          String
  cvFileName      String
  screeningPassed Boolean?
  status          ApplicationStatus @default(SCREENING)
  createdAt       DateTime          @default(now())

  tests Test[]

  @@unique([offerId, email])
  @@index([offerId, status])
}

model Test {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type           TestType
  status         TestStatus  @default(GENERATED)
  questions      Json
  answers        Json?
  totalScore     Int?
  criteriaScores Json?
  aiSummary      String?
  createdAt      DateTime    @default(now())
  completedAt    DateTime?

  @@unique([applicationId, type])
  @@index([applicationId, type])
}
